rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function recipeVisibleToUser() {
      return isSignedIn() &&
        request.auth.uid in resource.data.sharedWithUserIds;
    }

    function bookMember(bookId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/shared_books/$(bookId)).data.memberIds;
    }

    function bookOwner(bookId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/shared_books/$(bookId)).data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if isSelf(userId);
    }

    match /recipes/{recipeId} {
      allow read: if recipeVisibleToUser();
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.sharedWithUserIds;
      allow update, delete: if recipeVisibleToUser();
    }

    match /shared_books/{bookId} {
      allow read: if bookMember(bookId);
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if bookOwner(bookId);
    }

    match /shared_book_invites/{inviteId} {
      allow read: if isSignedIn() &&
        (
          resource.data.inviterId == request.auth.uid ||
          resource.data.inviteeUserId == request.auth.uid ||
          resource.data.inviteeEmail == request.auth.token.email
        );

      allow create: if isSignedIn() && bookMember(request.resource.data.bookId);

      allow update: if isSignedIn() &&
        (
          resource.data.inviterId == request.auth.uid ||
          resource.data.inviteeUserId == request.auth.uid ||
          resource.data.inviteeEmail == request.auth.token.email
        );
    }
  }
}

<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TextAppearance.RecipeBook.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textColor">@color/ink_900</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">serif</item>
    </style>

    <style name="TextAppearance.RecipeBook.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/ink_900</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">serif</item>
    </style>

    <style name="TextAppearance.RecipeBook.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/ink_900</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.RecipeBook.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/ink_700</item>
    </style>

    <style name="Widget.RecipeBook.PrimaryButton" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:textStyle">bold</item>
        <item name="shapeAppearance">@style/ShapeAppearance.RecipeBook.Pill</item>
        <item name="backgroundTint">@color/navy_500</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
    </style>

    <style name="Widget.RecipeBook.SecondaryButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textStyle">bold</item>
        <item name="shapeAppearance">@style/ShapeAppearance.RecipeBook.Pill</item>
        <item name="strokeColor">@color/stroke_strong</item>
        <item name="android:textColor">@color/navy_700</item>
        <item name="iconTint">@color/navy_700</item>
    </style>

    <style name="Widget.RecipeBook.InputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface_white</item>
        <item name="boxStrokeColor">@color/stroke_soft</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">22dp</item>
        <item name="boxCornerRadiusTopEnd">22dp</item>
        <item name="boxCornerRadiusBottomStart">22dp</item>
        <item name="boxCornerRadiusBottomEnd">22dp</item>
        <item name="hintTextColor">@color/ink_500</item>
    </style>

    <style name="Widget.RecipeBook.DropdownLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxBackgroundColor">@color/surface_white</item>
        <item name="boxStrokeColor">@color/stroke_soft</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">22dp</item>
        <item name="boxCornerRadiusTopEnd">22dp</item>
        <item name="boxCornerRadiusBottomStart">22dp</item>
        <item name="boxCornerRadiusBottomEnd">22dp</item>
        <item name="hintTextColor">@color/ink_500</item>
    </style>

    <style name="ShapeAppearance.RecipeBook.Pill" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">999dp</item>
    </style>

    <style name="ShapeAppearance.RecipeBook.Card" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

</resources>
